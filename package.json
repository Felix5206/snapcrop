{
  "name": "snapcrop",
  "version": "2.0.0",
  "description": "简裁 SnapCrop — 纯本地、零上传的照片裁切工具：照片批量 + 原像素无损精准裁切。",
  "keywords": [
    "photo-crop",
    "id-photo",
    "证件照",
    "batch-image",
    "canvas",
    "image-resize",
    "裁剪",
    "照片处理",
    "vanilla-js",
    "offline-tool"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Felix5206/snapcrop.git"
  },
  "bugs": {
    "url": "https://github.com/Felix5206/snapcrop/issues"
  },
  "homepage": "https://github.com/Felix5206/snapcrop#readme",
  "scripts": {
    "test": "node tests/run.js",
    "start": "python serve.py",
    "start:node": "npx --yes serve .",
    "start:php": "php -S 127.0.0.1:5173",
    "build:exe": "python -m PyInstaller --noconfirm --clean --onefile --name SnapCrop --icon assets/brand/app.ico --add-data \"index.html;.\" --add-data \"assets;assets\" --add-data \"config;config\" serve.py",
    "build:exe:win": "powershell -ExecutionPolicy Bypass -File scripts/build-exe.ps1",
    "build:installer": "powershell -ExecutionPolicy Bypass -File scripts/build-installer.ps1"
  },
  "engines": {
    "node": ">=16"
  }
}
